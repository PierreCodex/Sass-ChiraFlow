# Valores del build de producción (Coolify). Next los lee solo al hacer
# `next build` y las NEXT_PUBLIC_* quedan dentro del bundle del navegador:
# aquí NUNCA va un secreto. La URL de Laravel (API_URL) no va aquí: es de
# tiempo de ejecución y la pone Coolify. Guía: docs/infra/despliegue-web.md

NEXT_PUBLIC_APP_NAME=tivu

# Las tiendas: pepito.tivuapp.store -> /reservar/pepito
NEXT_PUBLIC_STORE_DOMAIN=tivuapp.store

NEXT_PUBLIC_LOCALE=es-PE
NEXT_PUBLIC_CURRENCY=PEN

# Lo mismo que en local: los módulos que ya hablan con Laravel, y mocks para
# el resto. Al conectar uno nuevo, se añade aquí y se redespliega.
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_MODULOS_CONECTADOS=categorias,servicios,clientes,roles,usuarios,profesionales,configuracion,capacidades,locales,inventario,citas,publico
