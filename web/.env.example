# Copia este archivo como .env.local y ajusta los valores.

# API de Laravel (con /api al final).
#
# La lee SOLO el BFF, en el servidor: el navegador le habla al proxy de Next
# (/api) y nunca a Laravel directo. En producción usa API_URL, sin el prefijo
# NEXT_PUBLIC_, para que la URL del backend no viaje en el bundle del cliente.
# Usa 127.0.0.1 y NO localhost: el fetch de Node resuelve `localhost` a ::1 y
# `php artisan serve` solo escucha en IPv4, así que el BFF respondería 502.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# API_URL=http://api.interno:8000/api

NEXT_PUBLIC_APP_NAME=Mi SaaS

# Dominio raíz de las tiendas públicas por subdominio:
#   mademoiselle.lienaben.com -> /reservar/mademoiselle
# Déjalo vacío en desarrollo: las tiendas siguen sirviéndose por ruta
# (/reservar/{slug}), igual que el fallback de Laravel.
# En producción requiere un dominio comodín *.tudominio.com apuntando aquí.
NEXT_PUBLIC_APP_DOMAIN=

# Formato de números/fechas y moneda de los importes
NEXT_PUBLIC_LOCALE=es-PE
NEXT_PUBLIC_CURRENCY=PEN

# Datos ficticios. Mientras no sea "false", la capa de servicios responde con
# los mocks de cada módulo.
NEXT_PUBLIC_USE_MOCKS=true

# Módulos que YA hablan con Laravel mientras el resto sigue con mocks. Se van
# sumando según los termina el backend, uno por sprint. Cuando estén todos:
# NEXT_PUBLIC_USE_MOCKS=false y esta lista sobra.
#
# Claves = nombre del módulo, no la ruta REST: categorias, servicios, clientes,
# usuarios, profesionales, roles, locales, citas, inventario, caja, soporte,
# whatsapp, reportes, dashboard, configuracion, suscripcion, publico.
# Sprint 1 (2026-08-27): categorias, servicios y clientes.
# `empleados` estuvo aquí y se ha ido: el backend borró /api/empleados el
# 2026-09-04 y lo partió en usuarios (quien entra al panel) y profesionales
# (quien presta los servicios).
# Sprint 2 (2026-09-04): usuarios, profesionales, roles y configuracion.
NEXT_PUBLIC_MODULOS_CONECTADOS=categorias,servicios,clientes,roles,usuarios,profesionales,configuracion,capacidades,locales
